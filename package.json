{
  "name": "taskflow",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js + TypeScript + Tailwind + shadcn/ui + PostgreSQL + Prisma 全栈任务管理系统",
  "scripts": {
    "dev": "tsx server.ts --dev",
    "dev:next": "next dev",
    "predev": "node scripts/gen-version.mjs",
    "build": "node scripts/gen-version.mjs && prisma generate && next build",
    "start": "tsx server.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "check:tve4": "tsx scripts/tve4/check_rules.ts",
    "check:data": "tsx scripts/tve4/check_data.ts"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@pixi/tilemap": "^5.0.2",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.1",
    "howler": "^2.2.4",
    "jsfxr": "^1.4.1",
    "lucide-react": "^0.469.0",
    "next": "15.5.29",
    "phaser": "^4.2.1",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.2",
    "three": "^0.187.0",
    "tsx": "^4.23.15",
    "ws": "^8.23.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/howler": "^2.2.13",
    "@types/node": "^22.10.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.0"
  }
}
