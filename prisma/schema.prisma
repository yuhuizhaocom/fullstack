generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique @db.VarChar(120)
  name         String    @db.VarChar(50)
  passwordHash String    @db.VarChar(200)
  role         UserRole  @default(USER)
  disabled     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tasks        Task[]        @relation("TaskOwner")
  sessions     Session[]
  chatMessages ChatMessage[] @relation("ChatAuthor")

  @@index([disabled])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique @db.VarChar(64)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model Task {
  id          String       @id @default(cuid())
  title       String       @db.VarChar(120)
  description String?      @db.VarChar(1000)
  assignee    String?      @db.VarChar(50)
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?    @db.Date
  ownerId     String?
  owner       User?        @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([ownerId])
  @@map("tasks")
}

model ChatMessage {
  id        String   @id @default(cuid())
  sender    String   @db.VarChar(50)
  content   String   @db.VarChar(2000)
  isGuest   Boolean  @default(true)
  userId    String?
  user      User?    @relation("ChatAuthor", fields: [userId], references: [id], onDelete: SetNull)
  clientId  String?  @db.VarChar(64)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@map("chat_messages")
}

model SharedFile {
  id         String   @id @default(cuid())
  name       String   @db.VarChar(200)
  size       Int
  mimeType   String?  @db.VarChar(120)
  storageKey String   @unique @db.VarChar(80)
  /** share：附件分享；clip：剪贴板图片（不出现在附件列表） */
  scope      String   @default("share") @db.VarChar(16)
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@index([scope, createdAt])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("shared_files")
}

model ClipEntry {
  id        String   @id @default(cuid())
  channel   String   @db.VarChar(16)
  content   String   @db.Text
  clientId  String   @db.VarChar(64)
  /** TEXT：文本内容；IMAGE：content 为 /api/files/{id} 图片地址 */
  kind      String   @default("TEXT") @db.VarChar(10)
  createdAt DateTime @default(now())

  @@index([channel, createdAt])
  @@map("clip_entries")
}
